{
  "name": "dot-web-demo",
  "version": "2.3.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm -r --parallel dev",
    "web-demo:dev": "pnpm -r --parallel --filter dot-web-demo-server --filter dot-web-demo-client dev",
    "ocr-demo:dev": "pnpm -r --parallel --filter dot-web-demo-server --filter dot-web-ocr-demo-client dev",
    "age-demo:dev": "pnpm -r --parallel --filter dot-web-demo-server --filter dot-web-age-client dev",
    "server:dev": "pnpm --filter dot-web-demo-server dev",
    "server:start": "pnpm --filter dot-web-demo-server start",
    "web-demo-client:dev": "pnpm --filter dot-web-demo-client dev",
    "ocr-demo-client:dev": "pnpm --filter dot-web-ocr-demo-client dev",
    "age-demo-client:dev": "pnpm --filter dot-web-age-client dev",
    "web-demo-client:build": "pnpm --filter dot-web-demo-client build",
    "ocr-demo-client:build": "pnpm --filter dot-web-ocr-demo-client build",
    "age-demo-client:build": "pnpm --filter dot-web-age-client build",
    "build": "pnpm -r --parallel build",
    "lint": "pnpm -r --parallel lint",
    "lint:fix": "pnpm exec biome check --write",
    "format": "pnpm exec biome format --write . && pnpm run organize-imports",
    "format:fix": "biome format --write && pnpm run organize-imports --fix",
    "organize-imports": "pnpm exec biome check --formatter-enabled=false --linter-enabled=false --organize-imports-enabled=true",
    "pr": "pnpm tsc && pnpm lint",
    "test": "pnpm --filter dot-web-demo-server test",
    "test:ui": "pnpm -r --parallel test:ui",
    "tsc": "pnpm -r --parallel tsc",
    "bump:version": "VERSION=$v pnpm --r bump:version && npm pkg set version=$v",
    "win-setup": "npm config set script-shell \"C:\\Program Files\\Git\\bin\\bash.exe\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@vitest/ui": "^4.0.4",
    "chai-colors": "^1.0.1",
    "husky": "^9.1.1",
    "jest-canvas-mock": "^2.5.2",
    "rimraf": "^6.0.1",
    "start-server-and-test": "^2.0.4",
    "typescript": "~5.9.3",
    "vitest": "^2.0.4"
  },
  "packageManager": "pnpm@10.34.9",
  "resolutions": {
    "@types/react": "^18.3.3"
  },
  "pnpm": {
    "overrides": {
      "@fastify/busboy@<3.2.1": "^3.2.1",
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "form-data@>=4 <4.0.6": "^4.0.6",
      "form-data@<2.5.6": "~2.5.6",
      "lodash@<4.18.0": "^4.18.0",
      "lodash-es@<4.18.0": "^4.18.0",
      "nanoid@<3.3.18": "^3.3.18",
      "preact@<10.28.2": "^10.28.2",
      "protobufjs@<7.6.1": "^7.6.1",
      "proxy-addr@<2.0.8": "^2.0.8",
      "websocket-driver@<0.7.5": "^0.7.5",
      "source-map-js@<1.2.2": "^1.2.2",
      "postcss@<8.5.18": "^8.5.18",
      "swiper@<12.1.2": "^12.1.2"
    }
  }
}
