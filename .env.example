# for local development set env for both clients
COMMON_APP_ENV=test
COMMON_DISABLE_CAMERA_ERROR=false
COMMON_COUNTLY_URL=https://innovatrics.count.ly

# dot-web-demo env variables have prefix WEB_DEMO_
WEB_DEMO_API_BASE_URL=http://localhost:${SERVER_PORT}/api
# app version value is added in vite.config.ts
WEB_DEMO_APP_VERSION=
WEB_DEMO_ENV=$COMMON_APP_ENV
WEB_DEMO_COUNTLY_URL=$COMMON_COUNTLY_URL
WEB_DEMO_COUNTLY_APP_KEY=
WEB_DEMO_DISABLE_CAMERA_ERROR=$COMMON_DISABLE_CAMERA_ERROR
# face autocapture stay-still phase in ms; empty = component default
WEB_DEMO_FACE_CANDIDATE_SELECTION_MS=

# server; with NODE_ENV=development DIS is called with DIS_AUTH_TOKEN (./dis-token.sh), otherwise via the DIS_* oauth2 client
SERVER_PORT=3000
MOCKS_ENABLED=false
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
NODE_ENV=development
DIS_URL=https://dot-dev.innovatrics.com/identity
DIS_AUTH_TOKEN=REPLACE_WITH_AUTH_TOKEN
DIS_TOKEN_URL=
DIS_AUDIENCE=
DIS_CLIENT_ID=
DIS_CLIENT_SECRET=
AWS_REGION=eu-central-1
AWS_S3_BUCKET_NAME=REPLACE_WITH_BUCKET
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ocr-demo env variables have prefix OCR_DEMO_
# app version value is added in vite.config.ts
OCR_DEMO_APP_VERSION=
OCR_DEMO_ENV=$COMMON_APP_ENV
OCR_DEMO_API_BASE_URL=$WEB_DEMO_API_BASE_URL
OCR_DEMO_DISABLE_CAMERA_ERROR=$COMMON_DISABLE_CAMERA_ERROR
OCR_DEMO_FALLBACK_URL=/poland
# uncomment and change to set base, "/" is default
# OCR_DEMO_BASE_PATH='/'
OCR_DEMO_GOOGLE_RECAPTCHA_KEY=
OCR_DEMO_COUNTLY_URL=$COMMON_COUNTLY_URL
OCR_DEMO_COUNTLY_APP_KEY=

FIREBASE_SERVICE_ACCOUNT_BASE64=